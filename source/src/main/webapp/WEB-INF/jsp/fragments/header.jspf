<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title><c:out value="${pageTitle}" default="AI Code Reviewer"/> · 코드 리뷰</title>
  <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
<body>
<a class="skip-link" href="#main">본문으로 건너뛰기</a>
<header class="site-header">
  <a class="brand" href="<c:url value='/'/>"><span class="brand-icon" aria-hidden="true">CR</span><span>Code Reviewer<small>AI 소스코드 리뷰</small></span></a>
  <sec:authorize access="isAuthenticated()">
    <nav aria-label="주 메뉴" class="main-nav">
      <a href="<c:url value='/'/>" ${activeSection == 'home' ? 'aria-current="page"' : ''}>홈</a>
      <a href="<c:url value='/projects'/>" ${activeSection == 'projects' ? 'aria-current="page"' : ''}>프로젝트</a>
      <a href="<c:url value='/issues'/>" ${activeSection == 'issues' ? 'aria-current="page"' : ''}>내 이슈</a>
      <sec:authorize access="hasRole('ADMIN')"><details class="admin-nav"><summary>관리자 메뉴</summary><div class="admin-menu"><a href="<c:url value='/admin/users'/>">가입 승인</a><a href="<c:url value='/admin/users?status='/>">사용자 관리</a><a href="<c:url value='/projects?status=PENDING'/>">프로젝트 승인</a><a href="<c:url value='/admin/git-authors'/>">Git 작성자 매핑</a><a href="<c:url value='/admin/operations'/>">운영 상태</a><a href="<c:url value='/admin/monitoring'/>">서버 상태</a><a href="<c:url value='/admin/audit'/>">감사 기록</a></div></details></sec:authorize>
      <a href="<c:url value='/account/password'/>" ${activeSection == 'account' ? 'aria-current="page"' : ''}>비밀번호 변경</a>
    </nav>
    <div class="session-menu">
      <span class="username"><c:out value="${pageContext.request.userPrincipal.name}"/></span>
      <form method="post" action="<c:url value='/logout'/>">
        <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
        <button type="submit" class="button-secondary compact">로그아웃</button>
      </form>
    </div>
  </sec:authorize>
  <sec:authorize access="!isAuthenticated()"><nav class="public-nav" aria-label="가입과 로그인"><a href="<c:url value='/login'/>">로그인</a><a class="button" href="<c:url value='/signup'/>">회원가입</a></nav></sec:authorize>
</header>
<main id="main" class="container">
  <sec:authorize access="isAuthenticated()"><c:if test="${not reviewWorkerEnabled}"><div id="review-worker-paused" class="notice" role="status">현재 서버의 리뷰 처리가 일시 중지되었습니다. 요청은 저장되며 관리자가 이 서버의 처리를 재개하면 이어서 처리합니다. 다른 서버에서는 처리가 계속될 수 있습니다.</div></c:if></sec:authorize>
  <c:if test="${not empty notice}"><div class="notice success" role="status"><c:out value="${notice}"/></div></c:if>
  <c:if test="${not empty message}"><div class="notice success" role="status"><c:out value="${message}"/></div></c:if>
  <c:if test="${not empty success}"><div class="notice success" role="status"><c:out value="${success}"/></div></c:if>
  <c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
