# Include within nginx's http {} context, after replacing host/certificate paths.
# This example assumes Nginx is the public edge on the same server as the app.
# Do not expose the application port. Do not reuse this trust policy behind another proxy unchanged.
limit_req_zone $binary_remote_addr zone=reviewer_requests:10m rate=10r/s;

server {
    listen 80;
    server_name reviewer.example.com;
    return 308 https://reviewer.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name reviewer.example.com;
    ssl_certificate /etc/ssl/ai-reviewer/fullchain.pem;
    ssl_certificate_key /etc/ssl/ai-reviewer/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;

    # Protect authenticated health/management endpoints at the edge too.
    location /actuator { return 404; }

    location / {
        limit_req zone=reviewer_requests burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host reviewer.example.com;
        proxy_set_header X-Forwarded-Host reviewer.example.com;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
